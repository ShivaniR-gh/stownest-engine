# ---- Client (safe to expose; Vite inlines VITE_* into the bundle) ----
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# demo | sheets  — "demo" runs on bundled sample rows and shows a persistent banner
VITE_DATA_SOURCE=sheets

# ---- Server only (Vercel env vars; NEVER prefix these with VITE_) ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_SA_EMAIL=sn-platform@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
SHEETS_SPREADSHEET_ID=1AbC...
# Comma-separated bootstrap super admins. Everyone else is resolved from the access_control tab.
SUPER_ADMIN_EMAILS=you@stownest.com
# Restrict sign-in to your Workspace domain
ALLOWED_HOSTED_DOMAIN=stownest.com
